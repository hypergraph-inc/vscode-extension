{
  "name": "hypergraph-vscode-extension",
  "displayName": "Hypergraph",
  "description": "View the Hypergraph inside VS Code",
  "version": "1.0.0",
  "author": "Zackary <zackary@hypergraph.digital> (https://zackary.dev)",
  "repository": {
    "type": "git",
    "directory": "vscode-extension",
    "url": "https://github.com/hypergraph-inc/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "hypergraph",
    "graph-visualization",
    "data-flow",
    "canvas",
    "webview",
    "interactive-diagram"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "prepack": "vsce package",
    "watch": "tsc -watch -p ./"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "files": [
    "out/**/*.js",
    "media/**/*",
    "*.png",
    "LICENSE",
    "README.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hypergraph.openPanel",
        "title": "Hypergraph: Open",
        "icon": "$(circuit-board)"
      },
      {
        "command": "hypergraph.pairDevice",
        "title": "Hypergraph: Pair Device with Account"
      },
      {
        "command": "hypergraph.signOut",
        "title": "Hypergraph: Forget Device Pairing"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypergraph-sidebar",
          "title": "Hypergraph",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hypergraph-sidebar": [
        {
          "type": "webview",
          "id": "hypergraph.sidebarView",
          "name": "Hypergraph Mini",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Hypergraph",
      "properties": {
        "hypergraph.url": {
          "type": "string",
          "default": "https://hypergraph.digital",
          "scope": "machine-overridable",
          "description": "Origin of the Hypergraph client to embed. Machine-scoped: a workspace cannot redirect this extension at another server."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
