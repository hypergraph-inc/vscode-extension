{
  "name": "hypergraph-vscode",
  "displayName": "Hypergraph",
  "description": "View the Hypergraph inside VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hypergraph.openPanel",
        "title": "Hypergraph: Open",
        "icon": "$(circuit-board)"
      },
      {
        "command": "hypergraph.pairDevice",
        "title": "Hypergraph: Pair Device with Account"
      },
      {
        "command": "hypergraph.signOut",
        "title": "Hypergraph: Forget Device Pairing"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hypergraph-sidebar",
          "title": "Hypergraph",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hypergraph-sidebar": [
        {
          "type": "webview",
          "id": "hypergraph.sidebarView",
          "name": "Hypergraph Mini",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Hypergraph",
      "properties": {
        "hypergraph.url": {
          "type": "string",
          "default": "https://hypergraph.digital",
          "scope": "machine-overridable",
          "description": "Origin of the Hypergraph client to embed. Machine-scoped: a workspace cannot redirect this extension at another server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
